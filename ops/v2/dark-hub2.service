[Unit]
Description=DARK v2 HUB core (node API)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/opt/dark-v2/dark-hub2 serve -db /var/lib/dark-hub2/v2.sqlite -listen ${DARK_HUB2_LISTEN} -tls-dir /etc/dark-hub2 -hosts ${DARK_HUB2_HOSTS} -sub-listen ${DARK_HUB2_SUB_LISTEN}
EnvironmentFile=/etc/dark-hub2/env
Restart=always
RestartSec=2
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ReadWritePaths=/var/lib/dark-hub2 /etc/dark-hub2
LimitNOFILE=65535

[Install]
WantedBy=multi-user.target

# LAB ONLY. Generate your own random secret; never commit a real value.
DARK_PRO_LAB_MODE=1
DARK_PRO_LAB_TOKEN=

# Separate store bots remain disabled until dedicated LAB identities are set.
# Enable only with native business + usage ledger and -telegram-bots-config.
# Bot tokens belong in the private config file, never in this environment file.
DARK_PRO_ENABLE_TELEGRAM_BOTS_V1=0
